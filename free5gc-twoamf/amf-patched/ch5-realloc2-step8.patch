diff --git a/internal/gmm/ch5_realloc.go b/internal/gmm/ch5_realloc.go
new file mode 100644
index 0000000..f2b314a
--- /dev/null
+++ b/internal/gmm/ch5_realloc.go
@@ -0,0 +1,66 @@
+package gmm
+
+// ch5: TS 23.502 4.2.2.2.3 step 7(A) -- the N1MessageNotify to the target AMF carries "the UE's SUPI and
+// MM Context if available". BuildUeContextModel omits the security context, so add it here, built the same
+// way as the UEContextTransfer producer (internal/sbi/processor/ue_context.go).
+
+import (
+	"encoding/base64"
+	"encoding/hex"
+
+	"github.com/free5gc/amf/internal/context"
+	nas_message "github.com/free5gc/nas/message"
+	"github.com/free5gc/openapi/models"
+)
+
+func ch5AddMmContext(ue *context.AmfUe, ueContext *models.Amf_Comm_UeContext) {
+	if !ue.SecurityContextAvailable || ue.Kamf == "" {
+		return
+	}
+	mmContext := models.Amf_Comm_MmContext{AccessType: models.AccessType_3_GPP_ACCESS}
+	mode := new(models.Amf_Comm_NasSecurityMode)
+	switch ue.IntegrityAlg {
+	case uint8(nas_message.AlgIntegrity128NIA0):
+		mode.IntegrityAlgorithm = models.Amf_Comm_IntegrityAlgorithm_NIA0
+	case uint8(nas_message.AlgIntegrity128NIA1):
+		mode.IntegrityAlgorithm = models.Amf_Comm_IntegrityAlgorithm_NIA1
+	case uint8(nas_message.AlgIntegrity128NIA2):
+		mode.IntegrityAlgorithm = models.Amf_Comm_IntegrityAlgorithm_NIA2
+	case uint8(nas_message.AlgIntegrity128NIA3):
+		mode.IntegrityAlgorithm = models.Amf_Comm_IntegrityAlgorithm_NIA3
+	}
+	switch ue.CipheringAlg {
+	case uint8(nas_message.AlgCiphering128NEA0):
+		mode.CipheringAlgorithm = models.Amf_Comm_CipheringAlgorithm_NEA0
+	case uint8(nas_message.AlgCiphering128NEA1):
+		mode.CipheringAlgorithm = models.Amf_Comm_CipheringAlgorithm_NEA1
+	case uint8(nas_message.AlgCiphering128NEA2):
+		mode.CipheringAlgorithm = models.Amf_Comm_CipheringAlgorithm_NEA2
+	case uint8(nas_message.AlgCiphering128NEA3):
+		mode.CipheringAlgorithm = models.Amf_Comm_CipheringAlgorithm_NEA3
+	}
+	mmContext.NasSecurityMode = mode
+	if ue.UESecurityCapability.Length > 0 {
+		if capability, err := ue.UESecurityCapability.MarshalBinary(); err == nil {
+			mmContext.UeSecurityCapability = base64.StdEncoding.EncodeToString(capability)
+		}
+	}
+	mmContext.NasDownlinkCount = int32(ue.DLCount.Get())
+	mmContext.NasUplinkCount = int32(ue.ULCount.Get())
+	for _, allowed := range ue.AllowedNssai[models.AccessType_3_GPP_ACCESS] {
+		if allowed.AllowedSnssai != nil {
+			mmContext.AllowedNssai = append(mmContext.AllowedNssai, *allowed.AllowedSnssai)
+		}
+	}
+	ueContext.MmContextList = append(ueContext.MmContextList, mmContext)
+
+	seaf := &models.Amf_Comm_SeafData{
+		NgKsi:  &models.Amf_Comm_NgKsi{Ksi: ue.NgKsi.Ksi, Tsc: ue.NgKsi.Tsc},
+		KeyAmf: &models.Amf_Comm_KeyAmf{KeyType: models.Amf_Comm_KeyAmfType_KAMF, KeyVal: ue.Kamf},
+		Ncc:    int32(ue.NCC),
+	}
+	if ue.NH != nil {
+		seaf.Nh = hex.EncodeToString(ue.NH)
+	}
+	ueContext.SeafData = seaf
+}
