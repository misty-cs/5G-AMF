+// ch5 patch 6: TS 24.501 5.5.1.3.2 -- the UE initiates a registration for mobility and periodic
+// registration update "when the UE needs to change the slice(s) it is currently registered to".
+void NasMm::ch5RequestSlice(const SingleSlice &slice)
+{
+    auto configured = m_storage->configuredNssai->get();
+    configured.addIfNotExists(slice);
+    m_storage->configuredNssai->set(configured);
+    m_logger->info("ch5: slice sst[%d] added to configured NSSAI; requesting registration update", (int)slice.sst);
+    mobilityUpdatingRequired(ERegUpdateCause::SLICE_CHANGE);
+}
